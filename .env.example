# ----------------------------------------------------------------------------
# SmartMindz — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). The site runs WITHOUT these using built-in
# fallback content, but registrations and live content require Supabase.
# ----------------------------------------------------------------------------

# Public — safe to expose to the browser (used for reads via RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose. Used by API routes + the gallery upload script
# to write data and bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for gallery/team/logo images (create it in Supabase).
NEXT_PUBLIC_SUPABASE_BUCKET=smartmindz
