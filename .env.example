# ----------------------------------------------------------------------------
# SmartMindz — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). The site runs WITHOUT these using built-in
# fallback content, but registrations and live content require Supabase.
# ----------------------------------------------------------------------------

# Public — safe to expose to the browser (used for reads via RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose. Used by API routes + the gallery upload script
# to write data and bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for gallery/team/logo images (create it in Supabase).
NEXT_PUBLIC_SUPABASE_BUCKET=smartmindz

# Server-only — video upload feature (see lib/google/drive.ts). Obtained by
# running `npx tsx scripts/google-drive-authorize.ts` once — see that script's
# header comment for the full Google Cloud Console setup steps. Leave unset to
# ship the site with video upload simply not configured (isVideoUploadOpen
# still gates it off separately via site_content, so this is a second guard,
# not the primary on/off switch).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
